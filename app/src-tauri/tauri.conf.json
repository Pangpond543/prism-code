{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Prism Code",
  "version": "1.6.0",
  "identifier": "com.prism.code",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Prism Code",
        "width": 1480,
        "height": 920,
        "minWidth": 1040,
        "minHeight": 680,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "center": true,
        "backgroundColor": "#e9eefc",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
